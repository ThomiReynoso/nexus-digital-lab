---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Media from '../components/portfolio-contenido/Media.astro';
import data from '../data/portfolio-contenido.json';

const { demo, hero, showreel, stats, formats, pillars, coaching, cases, testimonials, process } = data as any;

const formatLabel = (id: string) => formats.find((f: any) => f.id === id)?.label ?? id;
const pad = (n: number) => String(n).padStart(2, '0');

const whatsappUrl =
  'https://wa.me/5491166587697?text=' +
  encodeURIComponent('Hola, vi el portfolio de edición de Calax y quiero consultar por la edición de mis videos.');
---

<Layout
  title="Portfolio de edición de contenido | Calax Studio"
  description="Reels, Shorts, YouTube, podcasts y anuncios editados por Calax Studio. Casos reales con el antes y el después, resultados y testimonios de clientes."
  minimal
  noindex={demo}
>
  <Nav base="/" />

  <main class="pc">
    <!-- ─── Hero ─────────────────────────────────────────────────────────── -->
    <section class="pc-hero" id="hero">
      <div class="pc-blob pc-blob-1" aria-hidden="true"></div>
      <div class="pc-blob pc-blob-2" aria-hidden="true"></div>

      <div class="pc-wrap pc-hero-inner">
        <p class="section-label" data-animate>Portfolio · Edición de contenido</p>
        <h1 class="pc-hero-title" data-animate set:html={hero.title} />
        <p class="pc-hero-sub" data-animate>{hero.subtitle}</p>
        <div class="pc-hero-actions" data-animate>
          <a href="#casos" class="btn-primary">Ver casos</a>
          <a href="/#contacto" class="btn-secondary">Pedir presupuesto</a>
        </div>
      </div>

      <div class="pc-wrap">
        <div class="pc-showreel" data-animate>
          <Media media={showreel} mode="click" label="Reproducir showreel" />
          <span class="pc-showreel-tag">Showreel {new Date().getFullYear()}</span>
        </div>
      </div>
    </section>

    <!-- ─── Stats ────────────────────────────────────────────────────────── -->
    <section class="pc-wrap pc-stats" aria-label="Resultados en números">
      {stats.map((s: any) => (
        <div class="pc-stat" data-animate>
          <div class="pc-stat-value" data-counter={s.value}>{s.value}{s.suffix}</div>
          <div class="pc-stat-label">{s.label}</div>
        </div>
      ))}
    </section>

    <!-- ─── Pillars ──────────────────────────────────────────────────────── -->
    <section class="pc-wrap pc-section" id="servicios">
      <p class="section-label" data-animate>Cómo te acompañamos</p>
      <h2 class="section-title" data-split-text>No es solo edición: estamos <em>en todo el proceso</em></h2>

      <div class="pc-services">
        {pillars.map((s: any, i: number) => (
          <div class="pc-service" data-animate>
            <span class="pc-service-n">{pad(i + 1)}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            {s.items?.length > 0 && (
              <ul class="pc-service-items">
                {s.items.map((it: string) => <li>{it}</li>)}
              </ul>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- ─── Coaching ─────────────────────────────────────────────────────── -->
    <section class="pc-wrap pc-section" id="coaching">
      <div class="pc-coach">
        <div class="pc-coach-photo" data-animate>
          <img src={coaching.photo} alt={coaching.name} loading="lazy" />
          <div class="pc-coach-id">
            <strong>{coaching.name}</strong>
            <span>{coaching.role}</span>
          </div>
        </div>
        <div class="pc-coach-text" data-animate>
          <p class="section-label">{coaching.label}</p>
          <h2 class="pc-coach-title" set:html={coaching.title} />
          <p class="pc-coach-body">{coaching.text}</p>
          <ul class="pc-coach-points">
            {coaching.points.map((pt: string) => <li>{pt}</li>)}
          </ul>
          <a href="/#contacto" class="btn-secondary">Quiero una sesión</a>
        </div>
      </div>
    </section>

    <!-- ─── Cases ────────────────────────────────────────────────────────── -->
    <section class="pc-wrap pc-section" id="casos">
      <p class="section-label" data-animate>Casos</p>
      <h2 class="section-title" data-split-text>Del clip crudo a un video <em>que te representa</em></h2>

      <div class="pc-filters" role="group" aria-label="Filtrar casos por formato" data-animate>
        <button type="button" class="pc-chip is-active" data-filter="all" aria-pressed="true">Todos</button>
        {formats.map((f: any) => (
          <button type="button" class="pc-chip" data-filter={f.id} aria-pressed="false">{f.label}</button>
        ))}
      </div>

      <div class="pc-cases">
        {cases.map((c: any, i: number) => (
          <article class:list={['pc-case', i % 2 === 1 && 'is-reversed']} data-format={c.format} id={c.id}>
            <div class:list={['pc-case-media', `is-${c.orientation}`]} data-animate>
              <div class="pc-ba" data-ba data-state="after">
                <div class="pc-ba-layer" data-ba-layer="before">
                  <Media media={c.before} mode="ambient" />
                </div>
                <div class="pc-ba-layer" data-ba-layer="after">
                  <Media media={c.after} mode="ambient" />
                </div>
                <div class="pc-ba-toggle" role="group" aria-label="Comparar antes y después">
                  <button type="button" data-ba-btn="before" aria-pressed="false">Crudo</button>
                  <button type="button" data-ba-btn="after" aria-pressed="true" class="is-active">Editado</button>
                </div>
              </div>
            </div>

            <div class="pc-case-info" data-animate>
              <div class="pc-case-meta">
                <span class="pc-case-index">{pad(i + 1)} / {pad(cases.length)}</span>
                <span class="pc-tag">{formatLabel(c.format)}</span>
              </div>
              <h3 class="pc-case-client">{c.client}</h3>
              <p class="pc-case-niche">{c.niche} · <span>{c.deliverable}</span></p>

              <div class="pc-case-block">
                <h4>El desafío</h4>
                <p>{c.challenge}</p>
              </div>

              <div class="pc-case-block">
                <h4>Qué hicimos</h4>
                <ul class="pc-work">
                  {c.work.map((w: string) => <li>{w}</li>)}
                </ul>
              </div>

              <div class="pc-results">
                {c.results.map((r: any) => (
                  <div class="pc-result">
                    <div class="pc-result-value">{r.value}</div>
                    <div class="pc-result-label">{r.label}</div>
                  </div>
                ))}
              </div>

              {c.quote && (
                <blockquote class="pc-quote">
                  <p>“{c.quote}”</p>
                  <cite>{c.client}</cite>
                </blockquote>
              )}

              {c.profileUrl && (
                <a class="pc-case-link" href={c.profileUrl} target="_blank" rel="noopener noreferrer">
                  Ver {c.handle} →
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- ─── Testimonials ─────────────────────────────────────────────────── -->
    <section class="pc-section pc-testimonials" id="testimonios">
      <div class="pc-wrap">
        <p class="section-label" data-animate>Testimonios</p>
        <h2 class="section-title" data-split-text>Mejor que lo <em>cuenten ellos</em></h2>

        <div class="pc-tgrid">
          {testimonials.map((t: any) =>
            t.kind === 'video' ? (
              <figure class="pc-tcard pc-tcard-video" data-animate>
                <div class="pc-tvideo">
                  <Media media={t.media} mode="click" label={`Reproducir testimonio de ${t.name}`} />
                </div>
                <figcaption>
                  <strong>{t.name}</strong>
                  <span>{t.role}</span>
                </figcaption>
              </figure>
            ) : (
              <figure class="pc-tcard pc-tcard-audio" data-animate data-audio-card>
                <div class="pc-audio-badge">Testimonio en audio</div>
                {t.quote && <p class="pc-audio-quote">“{t.quote}”</p>}
                <div class="pc-audio">
                  <audio src={t.media.src} preload="metadata" data-audio></audio>
                  <button type="button" class="pc-audio-btn" data-audio-btn aria-label={`Escuchar a ${t.name}`}>
                    <svg class="i-play" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
                    <svg class="i-pause" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M7 5h4v14H7zM13 5h4v14h-4z" fill="currentColor" /></svg>
                  </button>
                  <div class="pc-wave" data-audio-bar aria-hidden="true">
                    {Array.from({ length: 36 }).map((_, k) => (
                      <span style={`height:${28 + Math.round(60 * Math.abs(Math.sin(k * 1.7) * Math.cos(k * 0.45)))}%`}></span>
                    ))}
                  </div>
                  <span class="pc-audio-time" data-audio-time>0:00</span>
                </div>
                <figcaption>
                  <strong>{t.name}</strong>
                  <span>{t.role}</span>
                </figcaption>
              </figure>
            )
          )}
        </div>
      </div>
    </section>

    <!-- ─── Process ──────────────────────────────────────────────────────── -->
    <section class="pc-wrap pc-section">
      <div class="pc-process" id="proceso">
        <p class="section-label" data-animate>Cómo trabajamos</p>
        <h2 class="section-title" data-split-text>Paso a paso, <em>con vos</em></h2>
        <ol class="pc-steps">
          {process.map((p: any, i: number) => (
            <li class="pc-step" data-animate>
              <span class="pc-step-dot">{i + 1}</span>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ─── CTA ──────────────────────────────────────────────────────────── -->
    <section class="pc-cta">
      <div class="pc-wrap pc-cta-inner" data-animate>
        <h2 class="pc-cta-title">¿Empezamos a <em>contar tu historia</em>?</h2>
        <p>Contanos de tu proyecto y vemos juntos cómo podemos acompañarte. Sin compromiso.</p>
        <div class="pc-hero-actions">
          <a href="/#contacto" class="btn-primary">Contanos tu proyecto</a>
          <a href={whatsappUrl} class="btn-secondary" target="_blank" rel="noopener noreferrer">Escribinos por WhatsApp</a>
        </div>
      </div>
    </section>
  </main>

  <Footer base="/" />

  {demo && (
    <div class="pc-demo-banner" role="note">
      <span class="pc-demo-dot" aria-hidden="true"></span>
      Versión de prueba · contenido de ejemplo
    </div>
  )}
</Layout>

<style>
  .pc {
    position: relative;
    z-index: 1;
    overflow-x: clip;
  }

  .pc-wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 48px);
  }

  .pc-section {
    padding-top: clamp(96px, 12vw, 160px);
  }

  /* ─── Hero ─── */
  .pc-hero {
    position: relative;
    padding-top: clamp(140px, 18vw, 200px);
  }

  .pc-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(110px);
    pointer-events: none;
    opacity: 0.35;
    z-index: -1;
  }

  .pc-blob-1 {
    width: 520px;
    height: 520px;
    background: var(--color-purple-deep);
    top: 40px;
    left: -160px;
  }

  .pc-blob-2 {
    width: 420px;
    height: 420px;
    background: var(--color-green-deep);
    top: 360px;
    right: -140px;
    opacity: 0.2;
  }

  .pc-hero-inner {
    max-width: 1000px;
    margin-bottom: clamp(48px, 6vw, 72px);
  }

  .pc-hero-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(40px, 5.6vw, 80px);
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--color-cream);
    margin-bottom: 28px;
  }

  .pc-hero-title :global(em),
  .pc-cta-title em {
    font-style: italic;
    background: linear-gradient(90deg, var(--color-purple), var(--color-green));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .pc-hero-sub {
    font-size: clamp(16px, 1.4vw, 19px);
    line-height: 1.6;
    color: var(--color-ink-muted);
    max-width: 620px;
    margin-bottom: 36px;
  }

  .pc-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .pc-showreel {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow:
      0 40px 120px rgba(123, 107, 176, 0.25),
      0 0 0 1px rgba(184, 169, 217, 0.08);
  }

  .pc-showreel-tag {
    position: absolute;
    top: 20px;
    left: 20px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 8px 14px;
    border-radius: 100px;
    background: rgba(10, 10, 10, 0.55);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    pointer-events: none;
  }

  /* ─── Stats ─── */
  .pc-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    margin-top: clamp(64px, 8vw, 96px);
  }

  .pc-stat {
    padding: 28px 24px;
    border-left: 1px solid rgba(255, 255, 255, 0.08);
  }

  .pc-stat:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .pc-stat-value {
    font-family: var(--font-serif);
    font-size: clamp(40px, 5vw, 64px);
    line-height: 1;
    color: var(--color-cream);
    margin-bottom: 10px;
  }

  .pc-stat-label {
    font-size: 13px;
    color: var(--color-ink-muted);
    line-height: 1.4;
  }

  /* ─── Filters ─── */
  .pc-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: -24px 0 56px;
  }

  .pc-chip {
    font: inherit;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.6);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 100px;
    padding: 9px 18px;
    cursor: pointer;
    transition: color 0.2s, background 0.2s, border-color 0.2s;
  }

  .pc-chip:hover {
    color: #fff;
    border-color: rgba(184, 169, 217, 0.5);
  }

  .pc-chip.is-active {
    color: #0A0A0A;
    background: var(--color-purple);
    border-color: var(--color-purple);
  }

  /* ─── Case ─── */
  .pc-cases {
    display: flex;
    flex-direction: column;
    gap: clamp(72px, 9vw, 120px);
  }

  .pc-case {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(32px, 6vw, 88px);
    align-items: center;
  }

  .pc-case[hidden] {
    display: none;
  }

  .pc-case.is-reversed .pc-case-media {
    order: 2;
  }

  .pc-case-media {
    display: flex;
    justify-content: center;
  }

  .pc-ba {
    position: relative;
    width: 100%;
    border-radius: 28px;
    overflow: hidden;
    background: #111110;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.55);
  }

  .is-vertical .pc-ba {
    aspect-ratio: 9 / 16;
    max-width: 360px;
  }

  .is-horizontal .pc-ba {
    aspect-ratio: 16 / 9;
  }

  .pc-ba-layer {
    position: absolute;
    inset: 0;
    transition: opacity 0.45s ease;
  }

  .pc-ba[data-state='after'] [data-ba-layer='before'],
  .pc-ba[data-state='before'] [data-ba-layer='after'] {
    opacity: 0;
    pointer-events: none;
  }

  .pc-ba-toggle {
    position: absolute;
    top: 14px;
    left: 14px;
    display: flex;
    padding: 4px;
    border-radius: 100px;
    background: rgba(10, 10, 10, 0.6);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    z-index: 2;
  }

  .pc-ba-toggle button {
    font: inherit;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.65);
    background: transparent;
    border: 0;
    border-radius: 100px;
    padding: 8px 16px;
    cursor: pointer;
    transition: color 0.2s, background 0.2s;
  }

  .pc-ba-toggle button.is-active {
    background: var(--color-cream);
    color: #0A0A0A;
  }

  .pc-case-meta {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 18px;
  }

  .pc-case-index {
    font-size: 12px;
    color: var(--color-ink-muted);
    letter-spacing: 0.08em;
  }

  .pc-tag {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-green);
    background: rgba(184, 232, 174, 0.08);
    border: 1px solid rgba(184, 232, 174, 0.2);
    padding: 5px 12px;
    border-radius: 100px;
  }

  .pc-case-client {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(32px, 3.6vw, 48px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-cream);
    margin-bottom: 8px;
  }

  .pc-case-niche {
    font-size: 15px;
    color: var(--color-purple);
    margin-bottom: 32px;
  }

  .pc-case-niche span {
    color: var(--color-ink-muted);
  }

  .pc-case-block {
    margin-bottom: 24px;
  }

  .pc-case-block h4 {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    margin-bottom: 10px;
  }

  .pc-case-block p {
    font-size: 16px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
  }

  .pc-work {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pc-work li {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.8);
    padding: 7px 14px;
    border-radius: 100px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.03);
  }

  .pc-results {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin: 32px 0 28px;
  }

  .pc-result {
    padding: 18px 16px;
    border-radius: 16px;
    background: linear-gradient(160deg, rgba(42, 35, 64, 0.7), rgba(28, 28, 26, 0.6));
    border: 1px solid rgba(184, 169, 217, 0.14);
  }

  .pc-result-value {
    font-family: var(--font-serif);
    font-size: clamp(26px, 2.6vw, 34px);
    line-height: 1;
    color: var(--color-green);
    margin-bottom: 8px;
  }

  .pc-result-label {
    font-size: 12px;
    line-height: 1.4;
    color: var(--color-ink-muted);
  }

  .pc-quote {
    border-left: 2px solid var(--color-purple-deep);
    padding: 4px 0 4px 20px;
    margin-bottom: 24px;
  }

  .pc-quote p {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 18px;
    line-height: 1.5;
    color: var(--color-cream);
    margin-bottom: 8px;
  }

  .pc-quote cite {
    font-style: normal;
    font-size: 13px;
    color: var(--color-ink-muted);
  }

  .pc-case-link {
    font-size: 14px;
    color: var(--color-purple);
    text-decoration: none;
    border-bottom: 1px solid rgba(184, 169, 217, 0.3);
    padding-bottom: 2px;
    transition: color 0.2s, border-color 0.2s;
  }

  .pc-case-link:hover {
    color: var(--color-green);
    border-color: var(--color-green);
  }

  /* ─── Testimonials ─── */
  .pc-tgrid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    align-items: stretch;
  }

  .pc-tcard {
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: #111110;
    display: flex;
    flex-direction: column;
  }

  .pc-tvideo {
    position: relative;
    aspect-ratio: 9 / 14;
  }

  .pc-tcard figcaption {
    padding: 18px 22px 22px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .pc-tcard figcaption strong {
    font-weight: 500;
    font-size: 15px;
    color: var(--color-cream);
  }

  .pc-tcard figcaption span {
    font-size: 13px;
    color: var(--color-ink-muted);
  }

  .pc-tcard-audio {
    background: linear-gradient(170deg, var(--color-purple-light) 0%, #111110 70%);
    padding-top: 28px;
  }

  .pc-audio-badge {
    margin: 0 22px 20px;
    align-self: flex-start;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-purple);
    border: 1px solid rgba(184, 169, 217, 0.3);
    padding: 5px 12px;
    border-radius: 100px;
  }

  .pc-audio-quote {
    font-family: var(--font-serif);
    font-size: clamp(20px, 2vw, 26px);
    line-height: 1.35;
    color: var(--color-cream);
    padding: 0 22px;
    flex: 1;
  }

  .pc-audio {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 28px 22px 4px;
    padding: 12px;
    border-radius: 100px;
    background: rgba(10, 10, 10, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .pc-audio-btn {
    flex-shrink: 0;
    width: 44px;
