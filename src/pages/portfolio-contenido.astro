</style>

<script>
  // ─── Ambient videos: play only while visible ────────────────────────────────
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const ambient = document.querySelectorAll<HTMLVideoElement>('video[data-ambient]');

  if (!reduceMotion && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const v = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            if (v.preload === 'none') v.preload = 'auto';
            v.play().catch(() => {});
          } else {
            v.pause();
          }
        });
      },
      { threshold: 0.35 }
    );
    ambient.forEach((v) => io.observe(v));
  } else {
    ambient.forEach((v) => (v.preload = 'metadata'));
  }

  // ─── Click-to-play (files and YouTube/Vimeo embeds) ─────────────────────────
  function pauseOthers(except?: HTMLMediaElement) {
    document.querySelectorAll<HTMLMediaElement>('video[data-click-video], audio[data-audio]').forEach((m) => {
      if (m !== except && !m.paused) m.pause();
    });
  }

  document.querySelectorAll<HTMLButtonElement>('.pc-media .pc-play').forEach((btn) => {
    btn.addEventListener('click', () => {
      const wrap = btn.closest('.pc-media') as HTMLElement;
      const embed = btn.dataset.embed;

      if (embed) {
        pauseOthers();
        const iframe = document.createElement('iframe');
        iframe.src = embed;
        iframe.allow = 'autoplay; fullscreen; picture-in-picture; encrypted-media';
        iframe.allowFullscreen = true;
        iframe.title = btn.getAttribute('aria-label') || 'Video';
        wrap.innerHTML = '';
        wrap.appendChild(iframe);
        return;
      }

      const video = wrap.querySelector<HTMLVideoElement>('video');
      if (!video) return;
      pauseOthers(video);
      video.controls = true;
      btn.remove();
      video.play().catch(() => {});
    });
  });

  document.querySelectorAll<HTMLVideoElement>('video[data-click-video]').forEach((v) => {
    v.addEventListener('play', () => pauseOthers(v));
  });

  // ─── Before / after toggle ───────────────────────────────────────────────────
  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((ba) => {
    const buttons = ba.querySelectorAll<HTMLButtonElement>('[data-ba-btn]');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const state = btn.dataset.baBtn as string;
        ba.dataset.state = state;
        buttons.forEach((b) => {
          const on = b === btn;
          b.classList.toggle('is-active', on);
          b.setAttribute('aria-pressed', String(on));
        });
        const shown = ba.querySelector<HTMLVideoElement>(`[data-ba-layer="${state}"] video`);
        if (shown && !reduceMotion) {
          shown.currentTime = 0;
          shown.play().catch(() => {});
        }
      });
    });
  });

  // ─── Format filter ───────────────────────────────────────────────────────────
  const chips = document.querySelectorAll<HTMLButtonElement>('.pc-chip');
  const cases = document.querySelectorAll<HTMLElement>('.pc-case');

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const f = chip.dataset.filter;
      chips.forEach((c) => {
        const on = c === chip;
        c.classList.toggle('is-active', on);
        c.setAttribute('aria-pressed', String(on));
      });
      cases.forEach((c) => {
        const show = f === 'all' || c.dataset.format === f;
        c.hidden = !show;
        if (show) {
          // Make sure filtered-in cases are visible even if their entrance animation never ran.
          c.querySelectorAll<HTMLElement>('[data-animate]').forEach((el) => {
            el.style.opacity = '1';
            el.style.visibility = 'visible';
            el.style.transform = 'none';
          });
        }
      });
      window.dispatchEvent(new Event('resize'));
    });
  });

  // ─── Audio testimonials ─────────────────────────────────────────────────────
  const fmt = (s: number) => {
    if (!isFinite(s)) return '0:00';
    const m = Math.floor(s / 60);
    return `${m}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
  };

  document.querySelectorAll<HTMLElement>('[data-audio-card]').forEach((card) => {
    const audio = card.querySelector<HTMLAudioElement>('audio[data-audio]')!;
    const btn = card.querySelector<HTMLButtonElement>('[data-audio-btn]')!;
    const bar = card.querySelector<HTMLElement>('[data-audio-bar]')!;
    const time = card.querySelector<HTMLElement>('[data-audio-time]')!;
    const bars = Array.from(bar.children) as HTMLElement[];

    audio.addEventListener('loadedmetadata', () => (time.textContent = fmt(audio.duration)));
    audio.addEventListener('timeupdate', () => {
      const p = audio.duration ? audio.currentTime / audio.duration : 0;
      const n = Math.round(p * bars.length);
      bars.forEach((b, i) => b.classList.toggle('is-played', i < n));
      time.textContent = fmt(audio.currentTime);
    });
    audio.addEventListener('play', () => {
      pauseOthers(audio);
      card.classList.add('is-playing');
    });
    audio.addEventListener('pause', () => card.classList.remove('is-playing'));
    audio.addEventListener('ended', () => card.classList.remove('is-playing'));

    btn.addEventListener('click', () => (audio.paused ? audio.play() : audio.pause()));
    bar.addEventListener('click', (e) => {
      const r = bar.getBoundingClientRect();
      if (audio.duration) audio.currentTime = ((e.clientX - r.left) / r.width) * audio.duration;
      if (audio.paused) audio.play();
    });
  });
</script>
