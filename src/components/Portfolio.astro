---
import data from '../data/portfolio-contenido.json';

const cards = data.cases.map((c) => ({
  id: c.id,
  client: c.client,
  niche: c.niche,
  poster:
    c.after.poster ??
    (c.after.type === 'youtube' ? `https://i.ytimg.com/vi/${c.after.src}/hqdefault.jpg` : ''),
}));
---

<section class="portfolio" id="portfolio">
  <div class="portfolio-head">
    <div>
      <p class="section-label" data-animate>Trabajo real</p>
      <h2 class="section-title" data-split-text>Contenido que <em>trabaja</em> por nuestros clientes</h2>
    </div>
    <a href="/portfolio-contenido" class="portfolio-all" data-animate>Ver portfolio completo →</a>
  </div>

  <div class="portfolio-grid">
    {cards.map((c) => (
      <a href="/portfolio-contenido#casos" class="pcard" data-animate>
        <img src={c.poster} alt={`Video editado para ${c.client}`} loading="lazy" />
        <div class="pcard-inner">
          <div class="pcard-cat">{c.niche}</div>
          <div class="pcard-name">{c.client}</div>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .portfolio {
    padding: clamp(60px, 8vw, 120px) clamp(24px, 4vw, 80px);
  }

  .portfolio-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: 48px;
  }

  .portfolio-all {
    color: var(--color-purple-light);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .portfolio-all:hover {
    text-decoration: underline;
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .pcard {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 16px;
    aspect-ratio: 4 / 5;
    background: #1a1622;
    transition: transform 0.25s;
  }

  .pcard:hover {
    transform: scale(1.02);
  }

  .pcard img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pcard-inner {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 24px;
    background: linear-gradient(to top, rgba(17, 17, 16, 0.85) 0%, transparent 60%);
  }

  .pcard-cat {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: rgba(247, 244, 239, 0.7);
    margin-bottom: 6px;
  }

  .pcard-name {
    font-family: var(--font-serif);
    font-size: 22px;
    color: white;
    line-height: 1.2;
  }

  @media (max-width: 960px) {
    .portfolio-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .portfolio {
      padding: 80px 20px;
    }
  }
</style>
